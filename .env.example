# Development — для Realtime/Presence нужен прямой *.supabase.co или прокси с WSS на /realtime/v1/websocket
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Optional: second host (e.g. Worker proxy) if primary is unreachable on some networks
# EXPO_PUBLIC_SUPABASE_FALLBACK_URL=https://vault-supabase-proxy.esaiam86.workers.dev
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_ARIA_API_URL=https://your-aria-domain.com

# Inline @pic — ключ Pexels (https://www.pexels.com/api/)
# Прод: только на сервере (не коммитить ключ в репо):
#   supabase secrets set PEXELS_API_KEY=your_pexels_key
#   supabase functions deploy search-pic
# Dev (опционально, fallback если edge без секрета):
# EXPO_PUBLIC_PEXELS_API_KEY=your_pexels_key

# Inline @gif — Giphy (https://developers.giphy.com/)
#   supabase secrets set GIPHY_API_KEY=your_giphy_key
#   supabase functions deploy search-gif
# EXPO_PUBLIC_GIPHY_API_KEY=your_giphy_key

# Production (Aria disabled)
# EXPO_PUBLIC_ARIA_API_URL=
