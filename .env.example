# Supabase (обязательно для auth и чатов)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Aria-lite / полная Aria (порт 8001 для lite, не 8000)
# Телефон в LAN:
# Свой IPv4: ipconfig → Wi‑Fi (не 127.0.0.1)
EXPO_PUBLIC_ARIA_API_URL=http://192.168.1.100:8001
# Клиент на том же ПК, что и сервер:
# EXPO_PUBLIC_ARIA_API_URL=http://127.0.0.1:8001

# ИИ-редактор (AiRewritePanel) — Groq на Supabase Edge, см. docs/EDGE_FUNCTIONS.md
# Секрет GROQ_API_KEY задаётся в Supabase Dashboard, не в .env клиента.
