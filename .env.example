# Supabase (обязательно для auth и чатов)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Aria-lite / полная Aria (порт 8001 для lite, не 8000)
# Телефон в LAN:
EXPO_PUBLIC_ARIA_API_URL=http://192.168.1.100:8001
# Клиент на том же ПК, что и сервер:
# EXPO_PUBLIC_ARIA_API_URL=http://127.0.0.1:8001

# xAI Grok — ИИ-редактор сообщений (AiRewritePanel)
# Получить ключ: https://console.x.ai
EXPO_PUBLIC_XAI_API_KEY=xai-xxxxxxxxxxxxxxxx
