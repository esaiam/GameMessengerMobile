# Креды для smoke:api и maestro:smoke (gitignored — скопируй в .env.smoke)
#
# cp .env.smoke.example .env.smoke   # или скопируй вручную на Windows

# Supabase test account (должен иметь @handle — не попадать на PickHandle)
SMOKE_TEST_EMAIL=you@example.com
SMOKE_TEST_PASSWORD=your-password

# Display name контакта в списке чатов (не Aria)
SMOKE_TEST_PEER_HANDLE=FriendName

# Опционально: второй user id/handle для API smoke room
# SMOKE_TEST_PEER_HANDLE уже используется для UI

# Android package (dev client: com.vault.messenger.dev)
MAESTRO_APP_ID=com.vault.messenger

# Опционально: фиксированный текст сообщения в Maestro
# MAESTRO_MESSAGE_TEXT=hello from maestro
